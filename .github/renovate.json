{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "configMigration": true,
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "commitMessageAction": "bump",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["gradle/libs.versions.toml"],
      "matchStrings": ["\\nktfmt\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "com.facebook:ktfmt",
      "datasourceTemplate": "maven",
      "versioningTemplate": "maven"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps",
      "groupName": "github actions"
    },
    {
      "matchManagers": ["gradle-wrapper"],
      "groupName": "gradle"
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin($|[:.])/"]
    },
    {
      "groupName": "kotlinx",
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlinx:/"]
    },
    {
      "groupName": "dokka",
      "matchPackageNames": ["/^org\\.jetbrains\\.dokka($|[:.])/"]
    },
    {
      "groupName": "android gradle plugin",
      "matchPackageNames": ["/^com\\.android($|[:.])/"]
    },
    {
      "groupName": "androidx",
      "matchPackageNames": ["/^androidx\\./", "/^com\\.google\\.android\\.material:/"]
    },
    {
      "groupName": "detekt",
      "matchPackageNames": ["/^dev\\.detekt($|[:.])/", "/^io\\.gitlab\\.arturbosch\\.detekt($|[:.])/"]
    },
    {
      "groupName": "formatting",
      "matchPackageNames": ["/^com\\.diffplug/", "com.facebook:ktfmt"]
    },
    {
      "groupName": "maven publish",
      "matchPackageNames": ["/^com\\.vanniktech($|[:.])/"]
    }
  ],
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "labels": ["dependencies", "security"]
  }
}
